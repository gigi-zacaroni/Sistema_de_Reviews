# Copie este arquivo para .env e preencha os valores.
# Usado ao rodar a API fora do Docker (npm start). No Docker Compose,
# as variáveis do banco já são definidas no docker-compose.yml.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=reviews_user
DB_PASSWORD=reviews_pass
DB_NAME=sistema_reviews
RAWG_API_KEY=coloque_sua_chave_aqui
