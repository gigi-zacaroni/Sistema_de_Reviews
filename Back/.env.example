# Copie este arquivo para Back/.env (cp .env.example .env) e preencha a RAWG_API_KEY.
# No Docker Compose, as variáveis do banco e do servidor de e-mail (Mailpit) já são
# definidas no docker-compose.yml; o resto vem deste arquivo.
PORT=3000
APP_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=reviews_user
DB_PASSWORD=reviews_pass
DB_NAME=sistema_reviews

RAWG_API_KEY=coloque_sua_chave_aqui

# Autenticação (JWT). Troque o segredo por um texto longo e aleatório.
JWT_SECRET=troque_este_segredo_por_um_texto_longo_e_aleatorio
JWT_EXPIRES_IN=2h

# Administrador criado automaticamente quando a API sobe (se o e-mail ainda não existir).
# Troque a senha se for usar fora de testes.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@reviews.com
ADMIN_SENHA=Admin@12345

# Recuperação de senha por e-mail.
# Com Docker, o docker-compose.yml aponta para o Mailpit (caixa de e-mails de teste).
# Rodando a API fora do Docker, use um SMTP real ou um Mailpit local na porta 1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sistema de Reviews <nao-responder@sistemareviews.local>
RESET_TOKEN_MINUTES=30
